# ─────────────────────────────────────────────────────
# Career Agent — Environment Variables
# Copy this file to .env and fill in your values.
# These override anything set in config.yaml.
# ─────────────────────────────────────────────────────

# Uncomment and set these only if your Ollama runs on a non-default port
# OLLAMA_BASE_URL=http://localhost:11434

# Override model names if needed
# REASONING_MODEL=qwen3:8b
# VISION_MODEL=gemma3:4b

# Override the database location (absolute path)
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/career_agent.db

# Set to "false" to go live with real applications
# DRY_RUN=true

# Webhook URL for notifications (Phase 3)
# NOTIFICATION_WEBHOOK_URL=
